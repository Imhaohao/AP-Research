# Supabase — new project: paste supabase/setup_all.sql in Dashboard → SQL Editor → Run
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key from Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: server-only; bypasses RLS. Prefer this for production instead of broad anon UPDATE policies.
SUPABASE_SERVICE_ROLE_KEY=

# Server key for the writing-task ChatGPT assistant (/api/llm/openai)
OPENAI_API_KEY=
# Optional override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Optional: Google Gemini API if you use other routes or tools
GOOGLE_API_KEY=

# Optional: school Gemini page — shown as “open in new tab” on the writing task
NEXT_PUBLIC_SCHOOL_GEMINI_URL=

# true = hide built-in ChatGPT chat; use only the school Gemini link above (if set)
NEXT_PUBLIC_GEMINI_SCHOOL_ONLY=false

# Treatment uses Stanford CRAFT–inspired narrative + AI lesson by default. Set true to use the older Prompt Engineering module + explanation task instead.
NEXT_PUBLIC_LEGACY_TREATMENT_MODULE=false
